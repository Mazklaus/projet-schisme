; Projet Schisme : jeu narratif 2.5D à épisodes, PC natif. Dépôt PRIVÉ.
config_version=5

[application]

config/name="Projet Schisme"
config/description="Jeu narratif 2.5D à épisodes (prototype privé)."
run/main_scene="res://scenes/ui/menu_principal.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Sauvegarde="*res://src/core/sauvegarde.gd"
Catalogue="*res://src/core/catalogue.gd"
Jeu="*res://src/core/jeu.gd"
MoniteurPerf="*res://src/perf/moniteur_perf.gd"
Son="*res://src/audio/son.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

